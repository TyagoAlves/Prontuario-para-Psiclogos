# Normaliza line endings para evitar diffs ruidosos e builds inconsistentes
# entre Windows (dev) e Linux (CI).
* text=auto eol=lf

# Arquivos que devem manter CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
